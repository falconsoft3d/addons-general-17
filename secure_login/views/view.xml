<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========== secure.login ========== -->

    <record id="view_secure_login_tree" model="ir.ui.view">
        <field name="name">secure.login.tree</field>
        <field name="model">secure.login</field>
        <field name="arch" type="xml">
            <tree string="Historial de Inicios de Sesión" decoration-success="user_id != False">
                <field name="date"/>
                <field name="user_id"/>
                <field name="login"/>
                <field name="ip_address"/>
            </tree>
        </field>
    </record>

    <record id="view_secure_login_form" model="ir.ui.view">
        <field name="name">secure.login.form</field>
        <field name="model">secure.login</field>
        <field name="arch" type="xml">
            <form string="Inicio de Sesión" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="login"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_secure_login_search" model="ir.ui.view">
        <field name="name">secure.login.search</field>
        <field name="model">secure.login</field>
        <field name="arch" type="xml">
            <search string="Buscar Inicios de Sesión">
                <field name="user_id"/>
                <field name="login"/>
                <field name="ip_address"/>
                <filter name="today" string="Hoy"
                    domain="[('date','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_secure_login" model="ir.actions.act_window">
        <field name="name">Historial de Inicios de Sesión</field>
        <field name="res_model">secure.login</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_secure_login_tree"/>
    </record>

    <!-- ========== secure.login.failed ========== -->

    <record id="view_secure_login_failed_tree" model="ir.ui.view">
        <field name="name">secure.login.failed.tree</field>
        <field name="model">secure.login.failed</field>
        <field name="arch" type="xml">
            <tree string="Intentos Fallidos de Acceso" decoration-danger="login != False">
                <field name="date"/>
                <field name="login"/>
                <field name="ip_address"/>
            </tree>
        </field>
    </record>

    <record id="view_secure_login_failed_form" model="ir.ui.view">
        <field name="name">secure.login.failed.form</field>
        <field name="model">secure.login.failed</field>
        <field name="arch" type="xml">
            <form string="Intento Fallido" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="login"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_secure_login_failed_search" model="ir.ui.view">
        <field name="name">secure.login.failed.search</field>
        <field name="model">secure.login.failed</field>
        <field name="arch" type="xml">
            <search string="Buscar Intentos Fallidos">
                <field name="login"/>
                <field name="ip_address"/>
                <filter name="today" string="Hoy"
                    domain="[('date','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_login" string="Login" context="{'group_by': 'login'}"/>
                    <filter name="group_ip" string="IP" context="{'group_by': 'ip_address'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_secure_login_failed" model="ir.actions.act_window">
        <field name="name">Intentos Fallidos de Acceso</field>
        <field name="res_model">secure.login.failed</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_secure_login_failed_tree"/>
    </record>

    <!-- ========== secure.password.wizard ========== -->

    <record id="view_secure_password_wizard_form" model="ir.ui.view">
        <field name="name">secure.password.wizard.form</field>
        <field name="model">secure.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignación Masiva de Contraseñas Seguras">
                <sheet>
                    <div class="oe_title">
                        <h1>Asignación Masiva de Contraseñas Seguras</h1>
                    </div>
                    <div class="alert alert-info" role="alert" style="margin-bottom:12px;">
                        Se generará una contraseña segura de 12 caracteres (mayúsculas,
                        minúsculas, dígitos y caracteres especiales) para cada usuario
                        seleccionado. Las contraseñas se actualizarán inmediatamente en
                        el sistema y se descargarán en un archivo <strong>XLSX</strong>.
                    </div>
                    <group>
                        <field name="send_email"
                               string="Enviar contraseña por correo a cada usuario"
                               help="Se enviará un correo con la nueva contraseña a cada usuario que tenga email configurado."/>
                    </group>
                    <field name="user_ids" nolabel="1">
                        <tree string="Usuarios" editable="bottom">
                            <field name="name" string="Nombre"/>
                            <field name="login" string="Login / Correo"/>
                            <field name="email" string="Email"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_generate_passwords"
                            type="object"
                            string="Generar y Descargar Contraseñas"
                            class="btn-primary"
                            data-loading-text="Generando…"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_secure_password_wizard_search" model="ir.ui.view">
        <field name="name">secure.password.wizard.search</field>
        <field name="model">secure.password.wizard</field>
        <field name="arch" type="xml">
            <search string="Asignacion Masiva de Contrasenas"/>
        </field>
    </record>

    <record id="action_secure_password_wizard" model="ir.actions.act_window">
        <field name="name">Asignación Masiva de Contraseñas</field>
        <field name="res_model">secure.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_secure_password_wizard_form"/>
        <field name="search_view_id" ref="view_secure_password_wizard_search"/>
        <field name="target">new</field>
    </record>

    <!-- ========== secure.audit.log ========== -->

    <record id="view_secure_audit_log_tree" model="ir.ui.view">
        <field name="name">secure.audit.log.tree</field>
        <field name="model">secure.audit.log</field>
        <field name="arch" type="xml">
            <tree string="Logs de Seguridad"
                  decoration-info="event_type == 'user_created'"
                  decoration-warning="event_type == 'company_changed'"
                  decoration-danger="event_type == 'config_changed'">
                <field name="date"/>
                <field name="event_type"/>
                <field name="operator_id"/>
                <field name="target_user_id"/>
                <field name="company_id"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_secure_audit_log_form" model="ir.ui.view">
        <field name="name">secure.audit.log.form</field>
        <field name="model">secure.audit.log</field>
        <field name="arch" type="xml">
            <form string="Log de Seguridad" create="false" delete="false">
                <sheet>
                    <group>
                        <group string="Evento">
                            <field name="date"/>
                            <field name="event_type"/>
                        </group>
                        <group string="Actores">
                            <field name="operator_id"/>
                            <field name="target_user_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_secure_audit_log_search" model="ir.ui.view">
        <field name="name">secure.audit.log.search</field>
        <field name="model">secure.audit.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Logs de Seguridad">
                <field name="operator_id"/>
                <field name="target_user_id"/>
                <field name="company_id"/>
                <field name="description"/>
                <filter name="user_created" string="Usuarios creados"
                    domain="[('event_type','=','user_created')]"/>
                <filter name="company_changed" string="Cambios en compañía"
                    domain="[('event_type','=','company_changed')]"/>
                <filter name="config_changed" string="Cambios de configuración"
                    domain="[('event_type','=','config_changed')]"/>
                <filter name="today" string="Hoy"
                    domain="[('date','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_event" string="Tipo de Evento" context="{'group_by': 'event_type'}"/>
                    <filter name="group_operator" string="Ejecutado por" context="{'group_by': 'operator_id'}"/>
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_secure_audit_log" model="ir.actions.act_window">
        <field name="name">Logs de Seguridad</field>
        <field name="res_model">secure.audit.log</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_secure_audit_log_tree"/>
        <field name="search_view_id" ref="view_secure_audit_log_search"/>
    </record>

    <!-- ========== security.responsible ========== -->

    <record id="view_security_responsible_tree" model="ir.ui.view">
        <field name="name">security.responsible.tree</field>
        <field name="model">security.responsible</field>
        <field name="arch" type="xml">
            <tree string="Responsables de Seguridad" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="notes"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_security_responsible_form" model="ir.ui.view">
        <field name="name">security.responsible.form</field>
        <field name="model">security.responsible</field>
        <field name="arch" type="xml">
            <form string="Responsable de Seguridad">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" placeholder="Seleccionar contacto..."/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" style="margin-bottom:12px;">
                        Este responsable recibirá alertas por correo cuando se detecten
                        <strong>10 o más intentos fallidos de acceso en menos de 1 minuto</strong>
                        desde la misma IP.
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_security_responsible_search" model="ir.ui.view">
        <field name="name">security.responsible.search</field>
        <field name="model">security.responsible</field>
        <field name="arch" type="xml">
            <search string="Buscar Responsables de Seguridad">
                <field name="partner_id"/>
                <field name="email"/>
                <filter name="active" string="Activos" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Inactivos" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_security_responsible" model="ir.actions.act_window">
        <field name="name">Responsables de Seguridad</field>
        <field name="res_model">security.responsible</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_responsible_tree"/>
        <field name="search_view_id" ref="view_security_responsible_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ========== Menús ========== -->

    <menuitem id="menu_secure_login_root"
        name="Control de Acceso"
        sequence="90"
        parent="base.menu_administration"
        groups="base.group_system"/>

    <menuitem id="menu_secure_login"
        name="Inicios de Sesión"
        parent="menu_secure_login_root"
        action="action_secure_login"
        sequence="10"
        groups="base.group_system"/>

    <menuitem id="menu_secure_login_failed"
        name="Intentos Fallidos"
        parent="menu_secure_login_root"
        action="action_secure_login_failed"
        sequence="20"
        groups="base.group_system"/>

    <menuitem id="menu_secure_password_wizard"
        name="Asignación Masiva de Contraseñas"
        parent="menu_secure_login_root"
        action="action_secure_password_wizard"
        sequence="30"
        groups="base.group_system"/>

    <menuitem id="menu_secure_audit_log"
        name="Logs de Seguridad"
        parent="menu_secure_login_root"
        action="action_secure_audit_log"
        sequence="40"
        groups="base.group_system"/>

    <menuitem id="menu_security_responsible"
        name="Responsables de Seguridad"
        parent="menu_secure_login_root"
        action="action_security_responsible"
        sequence="50"
        groups="base.group_system"/>

</odoo>

